<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Jangan proses lagi jika request sudah mengarah ke public/
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # Jika file atau direktori ada di folder public/, layani langsung (CSS, JS, gambar, dll)
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.+)$ public/$1 [L]

    # Semua request lain ke front controller Laravel (tanpa mengubah URL di browser)
    RewriteRule ^ public/index.php [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
